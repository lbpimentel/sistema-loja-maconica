generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Member {
  id                    Int             @id @default(autoincrement())
  nome                  String
  cpf                   String?
  rg                    String?
  dataNascimento        String?
  estadoCivil           String?
  profissao             String?
  nacionalidade         String?
  naturalidade          String?
  nomePai               String?
  nomeMae               String?
  
  // Endereço Residencial
  cepResidencial        String?
  enderecoResidencial   String?
  numeroResidencial     String?
  complementoResidencial String?
  bairroResidencial     String?
  cidadeResidencial     String?
  estadoResidencial     String?
  telefoneResidencial   String?
  celular               String?
  email                 String?

  // Endereço Profissional
  cepProfissional       String?
  enderecoProfissional  String?
  numeroProfissional    String?
  complementoProfissional String?
  bairroProfissional    String?
  cidadeProfissional    String?
  estadoProfissional    String?
  telefoneProfissional  String?
  emailProfissional     String?

  // Cônjuge
  nomeConjuge           String?
  dataNascimentoConjuge String?
  casamentoData         String?
  
  // Filhos (relação 1:N)
  filhos                FamilyMember[]

  // Vida Maçônica
  cim                   String?
  dataIniciacao         String?
  lojaIniciacao         String?
  dataElevacao          String?
  lojaElevacao          String?
  dataExaltacao         String?
  lojaExaltacao         String?
  dataInstalacao        String?
  grauFilosofico        String?

  // Status e Voto
  statusAtual           String?
  cargoLoja             String?
  cargoPotencia         String?
  direitoVoto           Boolean         @default(false)

  // Cargos (relação 1:N)
  cargos                MasonicRole[]

  // Frequência e Estatísticas (Leitura)
  numeroSessoes         Int?            @default(0)
  presencas             Int?            @default(0)
  faltas                Int?            @default(0)
  frequencia            String?         @default("0")

  observacoes           String?

  foto                  String?         // URL ou Base64

  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
}

model FamilyMember {
  id          Int      @id @default(autoincrement())
  nome        String
  nascimento  String?
  sexo        String?
  membro      Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId    Int
}

model MasonicRole {
  id          Int      @id @default(autoincrement())
  cargo       String
  periodo     String
  loja        String?
  membro      Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId    Int
}
